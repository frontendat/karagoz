{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat); file=$(echo \"$input\" | jq -r '.tool_input.file_path // empty'); case \"$file\" in *.ts|*.tsx|*.js|*.mjs|*.vue) oxfmt \"$file\" 2>/dev/null; oxlint --fix \"$file\" 2>/dev/null ;; esac; true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat); file=$(echo \"$input\" | jq -r '.tool_input.file_path // empty'); case \"$file\" in *apps/docs*) for d in packages/shared packages/sandbox packages/puppeteer; do [ ! -d \"$d/dist\" ] && echo \"WARNING: $d/dist missing\" && exit 2; done ;; esac; true"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "mattpocock-skills@mattpocock": true
  },
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "allowWrite": [
        "~/Library/pnpm/store",
        "~/Library/Caches/ms-playwright",
        "~/.cache/ms-playwright"
      ]
    },
    "network": {
      "allowedDomains": [
        "localhost",
        "127.0.0.1",
        "registry.npmjs.org",
        "*.github.com",
        "github.com",
        "raw.githubusercontent.com",
        "codeload.github.com",
        "objects.githubusercontent.com",
        "*.webcontainer-api.io",
        "*.webcontainer.io",
        "*.webcontainers.io",
        "developer.stackblitz.com",
        "*.stackblitz.io",
        "*.staticblitz.com",
        "w-corp-staticblitz.com"
      ]
    },
    "credentials": {
      "files": [
        { "path": "~/.aws/credentials", "mode": "deny" },
        { "path": "~/.ssh", "mode": "deny" },
        { "path": "~/.npmrc", "mode": "deny" }
      ],
      "envVars": [
        { "name": "NPM_TOKEN", "mode": "deny" },
        { "name": "GITHUB_TOKEN", "mode": "deny" },
        { "name": "GH_TOKEN", "mode": "deny" }
      ]
    }
  }
}
